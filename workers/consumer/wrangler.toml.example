name = "cf-newsletter-consumer"
account_id = "REPLACE_WITH_ACCOUNT_ID"
main = "src/index.ts"
compatibility_date = "2025-01-15"
compatibility_flags = ["nodejs_compat"]

# Tunables (sending identity, size cap, warmup schedule, etc.) are NOT declared
# here. They resolve from the D1 `settings` table, falling back to the built-in
# defaults in shared/settings.ts (edit them there or via the console).
#
# Secret (set with `wrangler secret put CF_READ_API_TOKEN`): an account-scoped
# token with "Account > Email > Read" (or broader read) so the consumer can
# read the account's daily sending quota from the Cloudflare API once per UTC
# day to drive the warmup daily cap. The account id comes from the
# ACCESS_ACCOUNT_ID setting. If the secret or account id is missing the daily
# cap falls back to WARMUP_FALLBACK_DAILY_CAP.
#
# Secrets (set via `wrangler secret put`):
#   LINK_SIGNING_KEY        — must match the tracker's value
#   ATTACHMENT_SIGNING_KEY  — must match the tracker's value

[[d1_databases]]
binding = "DB"
database_name = "cf-newsletter-db"
database_id = "REPLACE_WITH_D1_ID"

[[r2_buckets]]
binding = "ARCHIVE"
bucket_name = "cf-newsletter-archive"

[[send_email]]
name = "SEND_EMAIL"
# allowed_destination_addresses = []   # leave empty for any verified destination

# Producer binding — used to re-enqueue overflow when a daily/weekly cap is hit.
[[queues.producers]]
binding = "QUEUE"
queue = "cf-newsletter-queue"

[[queues.consumers]]
queue = "cf-newsletter-queue"
max_batch_size = 10
max_batch_timeout = 5
max_concurrency = 5
max_retries = 3
dead_letter_queue = "cf-newsletter-dlq"
