name = "cf-newsletter-ingest"
account_id = "REPLACE_WITH_ACCOUNT_ID"
main = "src/index.ts"
compatibility_date = "2025-01-15"
compatibility_flags = ["nodejs_compat"]

# Tunables (batch size, attachment limits, MIME rules, etc.) resolve from the
# D1 `settings` table, falling back to the built-in defaults in
# shared/settings.ts. The author allow-list lives in the D1 `authors` table.

[[d1_databases]]
binding = "DB"
database_name = "cf-newsletter-db"
database_id = "REPLACE_WITH_D1_ID"

[[r2_buckets]]
binding = "ARCHIVE"
bucket_name = "cf-newsletter-archive"

[[queues.producers]]
binding = "QUEUE"
queue = "cf-newsletter-queue"

# Configure an Email Routing rule to route this worker the newsletter inbound
# address, e.g. newsletter@yourdomain.com -> Worker `cf-newsletter-ingest`.
